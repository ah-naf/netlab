{
  "schemaVersion": 1,
  "lab": { "id": "lab-direct", "name": "Direct link" },
  "nodes": [
    { "id": "node-ns1", "name": "ns1", "type": "namespace", "role": "host" },
    { "id": "node-ns2", "name": "ns2", "type": "namespace", "role": "host" }
  ],
  "interfaces": [
    {
      "id": "if-ns1-eth0",
      "nodeId": "node-ns1",
      "name": "eth0",
      "mtu": 1500,
      "state": "up",
      "addresses": [{ "cidr": "10.0.0.1/24" }]
    },
    {
      "id": "if-ns2-eth0",
      "nodeId": "node-ns2",
      "name": "eth0",
      "mtu": 1500,
      "state": "up",
      "addresses": [{ "cidr": "10.0.0.2/24" }]
    }
  ],
  "links": [
    {
      "id": "link-ns1-ns2",
      "endpointA": "if-ns1-eth0",
      "endpointB": "if-ns2-eth0",
      "kind": "veth",
      "mtu": 1500,
      "state": "up"
    }
  ],
  "layout": {
    "node-ns1": { "x": 0, "y": 0 },
    "node-ns2": { "x": 400, "y": 0 }
  }
}

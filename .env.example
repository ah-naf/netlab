# Address the API listens on
NETLAB_API_ADDR=:8080

# Worker socket path (inside the git-ignored .sandbox/ folder)
NETLAB_WORKER_SOCKET=.sandbox/worker.sock

# Disposable VM only, never set on your own machine
# NETLAB_ALLOW_HOST=1

# Web client settings (read at build time, visible to the browser)
# Empty base URL means use the Vite proxy
VITE_API_BASE_URL=
# Empty token means no Authorization header
VITE_API_TOKEN=
